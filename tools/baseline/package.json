{
  "name": "@navx/baseline-harness",
  "version": "0.0.0",
  "private": true,
  "description": "Stage 0 \u2014 captures visual baselines from the legacy NAVX source so every later stage has a regression net. Reads legacy from NAVX_LEGACY_ROOT; never vendors it.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "extract": "node tools/extract-legacy.mjs",
    "serve": "node tools/serve.mjs",
    "baseline:update": "playwright test --update-snapshots",
    "baseline:check": "playwright test",
    "baseline:report": "playwright show-report",
    "stage0": "npm run extract && npm run baseline:update",
    "stage2": "node tools/compare-renders.mjs --harness stage2",
    "stage2:sheet": "node tools/contact-sheet.mjs",
    "stage2:probe": "node tools/probe-geometry.mjs",
    "stage2:boxes": "node tools/diff-boxes.mjs",
    "stage2:colours": "node tools/diff-colours.mjs",
    "stage2:layers": "node tools/layer-loss.mjs",
    "stage2:utilities": "node tools/assert-utilities.mjs",
    "tokens": "node tools/assert-tokens.mjs",
    "stage2:rtl": "node tools/rtl-audit.mjs",
    "stage2:rtl-sheet": "node tools/rtl-sheet.mjs",
    "stage3:leak": "node tools/leak-test.mjs",
    "stage3:a11y": "node tools/a11y-test.mjs",
    "stage5:extract": "node tools/extract-presets.mjs",
    "stage5:identity": "node tools/stage5-identity.mjs",
    "stage5": "node tools/compare-renders.mjs --harness stage5",
    "stage6:overlay": "node tools/assert-overlay.mjs",
    "stage6:scrollspy": "node tools/assert-scrollspy.mjs",
    "site": "node tools/verify-site.mjs"
  },
  "//devDependencies": "Playwright is pinned exactly, not ranged. Chromium build differences change text rasterisation, which silently invalidates every baseline. Upgrading is a deliberate act that requires re-approving the snapshots.",
  "devDependencies": {
    "@navx/codemod": "workspace:*",
    "@navx/core": "workspace:*",
    "@navx/element": "workspace:*",
    "@navx/presets": "workspace:*",
    "@navx/react": "workspace:*",
    "@navx/svelte": "workspace:*",
    "@navx/vue": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@vue/server-renderer": "^3.5.13",
    "axe-core": "^4.13.0",
    "jsdom": "^25.0.1",
    "pixelmatch": "6.0.0",
    "pngjs": "7.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vue": "^3.5.13"
  }
}
