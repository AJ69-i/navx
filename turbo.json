{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": ["src/**", "build.mjs", "package.json", "tsconfig.json", "tsup.config.ts"]
    },
    "typecheck": {
      // "build" (own), not just "^build" (upstream). @navx/tokens generates
      // src/generated.ts during its own build and that file is gitignored, so
      // on a clean clone typecheck has nothing to resolve without this.
      "dependsOn": ["^build", "build"],
      "inputs": ["src/**", "test/**", "tsconfig.json"]
    },
    "test": {
      "dependsOn": ["^build", "build"],
      "inputs": ["src/**", "test/**", "dist/**"]
    },
    "lint": { "inputs": ["src/**", "test/**"] },
    "publint": { "dependsOn": ["build"], "outputs": [] }
  }
}
