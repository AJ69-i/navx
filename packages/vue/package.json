{
  "name": "@navx/vue",
  "version": "1.0.0",
  "type": "module",
  "description": "Vue binding for @navx/core — shallowRef and onScopeDispose, 702 B gzipped.",
  "keywords": ["navx", "vue", "navbar", "navigation", "headless", "composable", "accessibility"],
  "license": "MIT",
  "author": "Ahmed Jab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AJ69-i/navx.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/AJ69-i/navx/tree/main/packages/vue#readme",
  "bugs": {
    "url": "https://github.com/AJ69-i/navx/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./preset": {
      "import": {
        "types": "./dist/preset.d.ts",
        "default": "./dist/preset.js"
      },
      "require": {
        "types": "./dist/preset.d.cts",
        "default": "./dist/preset.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "preset": ["./dist/preset.d.ts"]
    }
  },
  "files": ["dist", "LICENSE"],
  "sideEffects": ["*.css"],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup && node ../../scripts/emit-types.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "publint": "publint",
    "attw": "attw --pack ."
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "catalog:",
    "jsdom": "^25.0.1",
    "publint": "0.2.12",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue": "^3.5.42"
  },
  "dependencies": {
    "@navx/core": "workspace:^",
    "@navx/presets": "workspace:^"
  },
  "//peerDependencies": "effectScope/onScopeDispose landed in 3.2, and the composable ties its teardown to the scope rather than to onUnmounted so it works outside a component too.",
  "peerDependencies": {
    "vue": ">=3.2"
  },
  "//typesVersions": "node10 resolution (TypeScript moduleResolution:\"node\") predates `exports` and cannot follow ./preset into dist. This maps it, so the subpath is typed for older consumers instead of silently untyped."
}
