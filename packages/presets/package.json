{
  "name": "@navx/presets",
  "version": "1.0.0",
  "type": "module",
  "description": "The NAVX catalogue as data — 28 presets averaging 179 B, and one render plan five frameworks walk.",
  "keywords": ["navx", "navbar", "navigation", "presets", "megamenu", "templates", "ssr"],
  "license": "MIT",
  "author": "Ahmed Jab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AJ69-i/navx.git",
    "directory": "packages/presets"
  },
  "homepage": "https://github.com/AJ69-i/navx/tree/main/packages/presets#readme",
  "bugs": {
    "url": "https://github.com/AJ69-i/navx/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./demo/*": {
      "import": {
        "types": "./dist/demo/*.d.ts",
        "default": "./dist/demo/*.js"
      },
      "require": {
        "types": "./dist/demo/*.d.cts",
        "default": "./dist/demo/*.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "LICENSE"],
  "sideEffects": ["*.css"],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup && node ../../scripts/emit-types.mjs",
    "typecheck": "tsc --noEmit",
    "test": "echo \"no tests yet\"",
    "publint": "publint",
    "attw": "attw --pack ."
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "catalog:",
    "publint": "0.2.12",
    "tsup": "catalog:",
    "typescript": "catalog:"
  }
}
