{
  "$description": "Legacy: navigation-skin-rounded-boxed.css (24 declarations). Identical to boxed but for one radius.",
  "link": {
    "color-hover": { "$type": "color", "$value": "{text.on-accent}" },
    "decoration": {
      "background": { "$type": "color", "$value": "{accent.default}" },
      "inline-size": { "$type": "dimension", "$value": "100%" },
      "block-size": { "$type": "dimension", "$value": "50%" },
      "radius": { "$type": "dimension", "$value": "{radius.lg}" }
    }
  }
}
