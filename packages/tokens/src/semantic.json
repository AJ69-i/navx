{
  "$description": "Tier 2 — semantic. THE THEMING API. This is the only tier a theme or a colour skin redefines. Every value here is a reference to tier 1; none is a literal.",
  "surface": {
    "$type": "color",
    "default": { "$value": "{color.gray.0}", "$description": "The bar and the off-canvas panel." },
    "raised": { "$value": "{color.gray.25}", "$description": "Dropdowns and mega-menus." },
    "sunken": { "$value": "{color.gray.50}", "$description": "Inputs." },
    "subtle": {
      "$value": "{color.gray.75}",
      "$description": "Social icon chips, tab strip, close button."
    },
    "active": { "$value": "{color.gray.100}", "$description": "Hovered / current dropdown item." },
    "inverse": { "$value": "{color.gray.950}" },
    "overlay": { "$value": "{color.alpha.black-70}" }
  },
  "border": {
    "$type": "color",
    "default": { "$value": "{color.gray.200}" },
    "strong": { "$value": "{color.gray.300}" },
    "accent": { "$value": "{color.brand.400}" }
  },
  "text": {
    "$type": "color",
    "default": { "$value": "{color.gray.650}" },
    "muted": { "$value": "{color.gray.400}" },
    "placeholder": { "$value": "{color.gray.600}" },
    "accent": { "$value": "{color.brand.500}" },
    "on-accent": { "$value": "{color.gray.0}" },
    "on-inverse": { "$value": "{color.gray.550}" }
  },
  "accent": {
    "$type": "color",
    "default": { "$value": "{color.brand.500}" },
    "hover": { "$value": "{color.brand.600}" },
    "subtle": { "$value": "{color.brand.400}" }
  },
  "shadow": {
    "$type": "shadow",
    "dropdown": { "$value": "0 12px 20px -5px rgba(0, 0, 0, 0.05)" },
    "tabs": { "$value": "0 3px 6px rgba(0, 0, 0, 0.07)" }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "color": { "$value": "{duration.base}" },
      "panel": { "$value": "{duration.slow}" },
      "submenu": { "$value": "{duration.fast}" }
    },
    "easing": {
      "$type": "cubicBezier",
      "default": { "$value": "{easing.standard}" }
    }
  }
}
