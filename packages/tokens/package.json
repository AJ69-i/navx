{
  "name": "@navx/tokens",
  "version": "1.0.0",
  "type": "module",
  "description": "Design tokens for NAVX — 201 DTCG tokens, a dark theme, RTL and ten skins, 2.3 kB gzipped.",
  "keywords": ["navx", "design-tokens", "dtcg", "css-variables", "theming", "dark-mode", "rtl"],
  "license": "MIT",
  "author": "Ahmed Jab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AJ69-i/navx.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/AJ69-i/navx/tree/main/packages/tokens#readme",
  "bugs": {
    "url": "https://github.com/AJ69-i/navx/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json",
    "./scss": "./dist/_tokens.scss",
    "./skins/*.css": "./dist/skins/*.css",
    "./package.json": "./package.json"
  },
  "files": ["dist", "LICENSE"],
  "sideEffects": ["*.css"],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node build.mjs && tsup && node ../../scripts/emit-types.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "publint": "publint",
    "attw": "attw --pack . --exclude-entrypoints tokens.css tokens.json scss 'skins/*.css'"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@arethetypeswrong/cli": "0.18.5",
    "publint": "0.2.12"
  }
}
