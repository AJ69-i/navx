{
  "name": "@navx/codemod",
  "version": "1.0.0",
  "type": "module",
  "description": "Rewrite legacy NAVX markup to the @navx API — the same mapping table the 292-screenshot visual gate validates.",
  "keywords": ["navx", "codemod", "migration", "navbar", "navigation", "refactor"],
  "license": "MIT",
  "author": "Ahmed Jab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AJ69-i/navx.git",
    "directory": "packages/codemod"
  },
  "homepage": "https://github.com/AJ69-i/navx/tree/main/packages/codemod#readme",
  "bugs": {
    "url": "https://github.com/AJ69-i/navx/issues"
  },
  "bin": {
    "navx-codemod": "./bin/navx-codemod.mjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./cli": {
      "import": {
        "types": "./dist/cli.d.ts",
        "default": "./dist/cli.js"
      },
      "require": {
        "types": "./dist/cli.d.cts",
        "default": "./dist/cli.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "cli": ["./dist/cli.d.ts"]
    }
  },
  "files": ["dist", "bin", "README.md", "LICENSE"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup && node ../../scripts/emit-types.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "publint": "publint",
    "attw": "attw --pack ."
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "catalog:",
    "jsdom": "^25.0.1",
    "publint": "0.2.12",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
