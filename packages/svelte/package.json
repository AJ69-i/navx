{
  "name": "@navx/svelte",
  "version": "1.0.0",
  "type": "module",
  "description": "Svelte binding for @navx/core — a store and an action, 429 B gzipped.",
  "keywords": [
    "navx",
    "svelte",
    "navbar",
    "navigation",
    "headless",
    "store",
    "action",
    "accessibility"
  ],
  "license": "MIT",
  "author": "Ahmed Jab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AJ69-i/navx.git",
    "directory": "packages/svelte"
  },
  "homepage": "https://github.com/AJ69-i/navx/tree/main/packages/svelte#readme",
  "bugs": {
    "url": "https://github.com/AJ69-i/navx/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./preset": {
      "import": {
        "types": "./dist/preset.d.ts",
        "default": "./dist/preset.js"
      },
      "require": {
        "types": "./dist/preset.d.cts",
        "default": "./dist/preset.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "preset": ["./dist/preset.d.ts"]
    }
  },
  "files": ["dist", "LICENSE"],
  "sideEffects": ["*.css"],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup && node ../../scripts/emit-types.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "publint": "publint",
    "attw": "attw --pack ."
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "catalog:",
    "jsdom": "^25.0.1",
    "publint": "0.2.12",
    "svelte": "^5.57.0",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@navx/core": "workspace:^",
    "@navx/presets": "workspace:^"
  },
  "//peerDependencies": "Nothing is imported from svelte: the store contract and the action contract are structural, which is why one build serves 3, 4 and 5 (including runes mode).",
  "peerDependencies": {
    "svelte": ">=3"
  },
  "//typesVersions": "node10 resolution (TypeScript moduleResolution:\"node\") predates `exports` and cannot follow ./preset into dist. This maps it, so the subpath is typed for older consumers instead of silently untyped."
}
