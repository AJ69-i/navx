{
  "name": "@navx/react",
  "version": "1.0.0",
  "type": "module",
  "description": "React binding for @navx/core — useSyncExternalStore, 620 B gzipped.",
  "keywords": [
    "navx",
    "react",
    "navbar",
    "navigation",
    "headless",
    "hook",
    "usesyncexternalstore",
    "accessibility"
  ],
  "license": "MIT",
  "author": "Ahmed Jab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AJ69-i/navx.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/AJ69-i/navx/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/AJ69-i/navx/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./preset": {
      "import": {
        "types": "./dist/preset.d.ts",
        "default": "./dist/preset.js"
      },
      "require": {
        "types": "./dist/preset.d.cts",
        "default": "./dist/preset.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "preset": ["./dist/preset.d.ts"]
    }
  },
  "files": ["dist", "LICENSE"],
  "sideEffects": ["*.css"],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup && node ../../scripts/emit-types.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "publint": "publint",
    "attw": "attw --pack ."
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "catalog:",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "publint": "0.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@navx/core": "workspace:^",
    "@navx/presets": "workspace:^"
  },
  "//peerDependencies": "React 18 is the floor because useSyncExternalStore is: on 17 this adapter cannot exist without the shim, and shipping the shim would put a second store implementation in every consumer's bundle.",
  "peerDependencies": {
    "react": ">=18"
  },
  "//typesVersions": "node10 resolution (TypeScript moduleResolution:\"node\") predates `exports` and cannot follow ./preset into dist. This maps it, so the subpath is typed for older consumers instead of silently untyped."
}
