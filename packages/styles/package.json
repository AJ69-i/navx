{
  "name": "@navx/styles",
  "version": "1.0.0",
  "type": "module",
  "description": "The NAVX stylesheet — 4.2 kB gzipped, zero !important, zero physical-direction properties, container queries and full RTL.",
  "keywords": [
    "navx",
    "navbar",
    "navigation",
    "css",
    "menu",
    "megamenu",
    "responsive",
    "rtl",
    "logical-properties",
    "container-queries"
  ],
  "license": "MIT",
  "author": "Ahmed Jab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AJ69-i/navx.git",
    "directory": "packages/styles"
  },
  "homepage": "https://github.com/AJ69-i/navx/tree/main/packages/styles#readme",
  "bugs": {
    "url": "https://github.com/AJ69-i/navx/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./navx.css": "./dist/navx.css",
    "./package.json": "./package.json",
    "./navx.min.css": "./dist/navx.min.css",
    "./navx.layer.css": "./dist/navx.layer.css",
    "./navx.layer.min.css": "./dist/navx.layer.min.css"
  },
  "files": ["dist", "LICENSE"],
  "sideEffects": ["*.css"],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node build.mjs && tsup && node ../../scripts/emit-types.mjs",
    "typecheck": "tsc --noEmit",
    "test": "echo \"no tests yet\"",
    "publint": "publint",
    "attw": "attw --pack . --exclude-entrypoints navx.css navx.min.css navx.layer.css navx.layer.min.css"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "catalog:",
    "lightningcss": "1.29.1",
    "publint": "0.2.12",
    "tsup": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@navx/tokens": "workspace:^"
  }
}
