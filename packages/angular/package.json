{
  "name": "@navx/angular",
  "version": "1.0.0",
  "type": "module",
  "description": "Angular binding for @navx/core — a standalone directive and signals, built with ng-packagr.",
  "keywords": [
    "navx",
    "angular",
    "navbar",
    "navigation",
    "headless",
    "directive",
    "signals",
    "accessibility"
  ],
  "license": "MIT",
  "author": "Ahmed Jab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AJ69-i/navx.git",
    "directory": "packages/angular"
  },
  "homepage": "https://github.com/AJ69-i/navx/tree/main/packages/angular#readme",
  "bugs": {
    "url": "https://github.com/AJ69-i/navx/issues"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "directory": "dist"
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json",
    "typecheck": "tsc --noEmit",
    "test": "node test/compile-check.mjs",
    "publint": "publint dist",
    "attw": "attw --pack ./dist --profile esm-only"
  },
  "devDependencies": {
    "@angular/common": "^22.1.5",
    "@angular/compiler": "^22.1.5",
    "@angular/compiler-cli": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "catalog:",
    "ng-packagr": "^22.1.1",
    "publint": "0.2.12",
    "rxjs": "^7",
    "tsup": "catalog:",
    "typescript": "6.0.2",
    "zone.js": "^0.15"
  },
  "//typescript": "NOT catalog: — Angular's compiler-cli pins >=6.0 <6.1 and cannot use the workspace's 7.x. See README.md.",
  "dependencies": {
    "@navx/core": "workspace:^",
    "@navx/presets": "workspace:^"
  },
  "peerDependencies": {
    "@angular/core": ">=18",
    "@angular/common": ">=18"
  },
  "peerDependenciesMeta": {
    "@angular/common": {
      "optional": true
    }
  },
  "//attw": "--profile esm-only rather than --ignore-rules cjs-resolves-to-esm. Angular libraries have been ESM-only since Angular 13, so node10 and require() resolution are not targets — declaring that is honest, where silencing one rule at a time would also have masked the secondary entry point node10 failure that ng-packagr cannot avoid."
}
