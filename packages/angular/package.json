{
  "name": "@navx/angular",
  "version": "0.0.0",
  "description": "Stage 4 \u2014 Angular adapter. Exempt from the workspace TypeScript catalog; see README.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json",
    "typecheck": "tsc --noEmit",
    "test": "node test/compile-check.mjs",
    "publint": "publint dist",
    "attw": "attw --pack ./dist --ignore-rules cjs-resolves-to-esm"
  },
  "devDependencies": {
    "@angular/common": "^22.1.5",
    "@angular/compiler": "^22.1.5",
    "@angular/compiler-cli": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "catalog:",
    "ng-packagr": "^22.1.1",
    "publint": "0.2.12",
    "rxjs": "^7",
    "tsup": "catalog:",
    "typescript": "6.0.2",
    "zone.js": "^0.15"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "directory": "dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trio-telecom/navx.git",
    "directory": "packages/angular"
  },
  "//typescript": "NOT catalog: \u2014 Angular's compiler-cli pins >=6.0 <6.1 and cannot use the workspace's 7.x. See README.md.",
  "dependencies": {
    "@navx/core": "workspace:*"
  },
  "peerDependencies": {
    "@angular/core": ">=18",
    "@angular/common": ">=18"
  },
  "peerDependenciesMeta": {
    "@angular/common": {
      "optional": true
    }
  }
}
