{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",

  // Anything gitignored is a build artifact and must not be linted. Without
  // this, `.turbo/cache/*.json` fails the lint step the moment turbo runs —
  // which makes `pnpm verify` pass or fail depending on whether a build
  // happened first.
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },

  "files": {
    "ignore": ["dist", "node_modules", ".turbo", "**/generated.ts"]
  },

  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },

  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": { "noNonNullAssertion": "off" },
      "suspicious": { "noConsoleLog": "off" }
    }
  },

  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "always" }
  },

  "overrides": [
    {
      // The baseline harness talks to a legacy plugin and to Playwright's
      // fixture API. These three rules are wrong for that code rather than the
      // code being wrong for the rules — see tools/baseline/BIOME.md. Product
      // packages under packages/** keep the full recommended set.
      "include": ["tools/baseline/**"],
      "linter": {
        "rules": {
          "complexity": { "noForEach": "off" },
          "correctness": { "noEmptyPattern": "off" },
          "suspicious": { "noExplicitAny": "off" }
        }
      }
    },
    {
      // TypeScript allows comments in every tsconfig, but Biome only infers
      // JSONC for the exact name `tsconfig.json` — so the Angular package's
      // extra project files parse as strict JSON and fail on their own
      // explanatory comments. Opt them in by name rather than dropping the
      // comments, which are the only place the `full` vs `partial` compilation
      // decision is written down.
      "include": ["packages/*/tsconfig.*.json"],
      "json": { "parser": { "allowComments": true } }
    },
    {
      // `interpolate-size` is newer than Biome's property list, so it reads as
      // a typo. It is the whole point of the progressive-enhancement block and
      // is guarded by `@supports (interpolate-size: allow-keywords)`, which
      // means an engine that does not know it never applies it either. Scoped
      // to the one file so a genuine typo elsewhere still fails the build.
      "include": ["packages/styles/src/navx.css"],
      "linter": {
        "rules": {
          "correctness": { "noUnknownProperty": "off" }
        }
      }
    }
  ]
}
